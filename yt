#!/usr/bin/env python3
"""YT Mini 5 — control a compact Chrome YouTube app window from Terminal (macOS)."""
import json, pathlib, re, shutil, subprocess, sys, os, socket, time

DATA = pathlib.Path.home()/'.yt-mini-native'
DATA.mkdir(parents=True,exist_ok=True)
RESULTS = DATA/'results.json'
STATE = DATA/'mini5.json'
CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'

def call(cmd):
    return subprocess.run(cmd,capture_output=True,text=True)

def osa(src):
    p=call(['osascript','-e',src])
    if p.returncode: raise RuntimeError(p.stderr.strip() or 'AppleScript failed')
    return p.stdout.strip()

def jsstr(s): return json.dumps(s,ensure_ascii=False)

def chrome_window():
    # Reuse the previously created Chrome window even after its URL changes.
    st=load_state()
    ident=st.get('window_id')
    if ident is not None:
        found=osa('''tell application "Google Chrome"
 repeat with w in windows
  if id of w is %d then return id of w
 end repeat
end tell
return ""''' % int(ident))
        if found: return int(found)
    # Recovery for users upgrading from older versions.
    video=st.get('video','')
    if video:
        sc='''tell application "Google Chrome"
 repeat with w in windows
  repeat with t in tabs of w
   try
    if URL of t contains %s then return id of w
   end try
  end repeat
 end repeat
end tell
return ""''' % jsstr('watch?v='+video)
        found=osa(sc)
        if found:
            st['window_id']=int(found);save_state(st)
            return int(found)
    raise RuntimeError('player window not found')

def with_window(action):
    ident=chrome_window()
    return osa('tell application "Google Chrome"\n set w to first window whose id is %d\n %s\nend tell' %(ident,action))

def player_key(key):
    # Accessibility permission is required for System Events key injection.
    ident=chrome_window()
    osa('''tell application "Google Chrome"
 set w to first window whose id is %d
 set minimized of w to false
 set index of w to 1
 activate
end tell
delay 0.2
tell application "System Events" to keystroke %s''' %(ident,jsstr(key)))

def video_id(s):
    if re.fullmatch(r'[\w-]{11}',s): return s
    m=re.search(r'(?:youtu\.be/|[?&]v=|youtube\.com/(?:shorts/|live/|embed/))([\w-]{11})',s)
    return m.group(1) if m else None

def load_state():
    try:return json.loads(STATE.read_text())
    except (OSError,ValueError):return {}

def save_state(s): STATE.write_text(json.dumps(s,ensure_ascii=False))

def open_video(video,index=None):
    if not pathlib.Path(CHROME).exists():
        raise RuntimeError('Google Chrome is not installed in /Applications')
    url='https://www.youtube.com/watch?v='+video
    st=load_state()
    width,height=st.get('size',[300,250])
    # Navigate the existing tab instead of opening a new Chrome window.
    try:
        ident=chrome_window()
        osa('''tell application "Google Chrome"
 set w to first window whose id is %d
 set URL of active tab of w to %s
 set minimized of w to false
 set index of w to 1
 activate
end tell''' % (ident,jsstr(url)))
    except RuntimeError:
        # New app-style window. Reuse an existing Chrome session for sign-in.
        try:before=osa('tell application "Google Chrome" to get id of every window')
        except RuntimeError:before='' 
        subprocess.Popen([CHROME,'--app='+url,'--window-size=%d,%d'%(width,height)],
                         stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        import time
        old={int(x) for x in re.findall(r'\d+',before)}
        ident=None
        for _ in range(35):
            time.sleep(.2)
            try:
                sc='''tell application "Google Chrome"
 repeat with w in windows
  if id of w is not in {%s} then
   repeat with t in tabs of w
    try
     if URL of t contains %s then return id of w
    end try
   end repeat
  end if
 end repeat
end tell
return ""''' % (','.join(map(str,old)) or '-1',jsstr('watch?v='+video))
                found=osa(sc)
                if found:
                    ident=int(found)
                    break
            except RuntimeError: pass
        if ident is None:
            # Fallback: locate video by URL (may also find older Chrome window).
            try:
                sc='''tell application "Google Chrome"
 repeat with w in windows
  repeat with t in tabs of w
   try
    if URL of t contains %s then return id of w
   end try
  end repeat
 end repeat
end tell
return ""''' % jsstr('watch?v='+video)
                found=osa(sc)
                if found: ident=int(found)
            except RuntimeError: pass
        if ident is None: raise RuntimeError('could not locate the player window')
        # Reapply saved size after Chrome creates the window.
        osa('''tell application "Google Chrome"
 set w to first window whose id is %d
 set b to bounds of w
 set bounds of w to {item 1 of b, item 2 of b, (item 1 of b) + %d, (item 2 of b) + %d}
end tell''' % (ident,width,height))
    st.update(video=video,index=index,window_id=ident)
    save_state(st)
    if is_pinned():
        pin_command('video '+video)
        try: with_window('set minimized of w to true')
        except RuntimeError: pass

PIN_BIN = pathlib.Path.home()/'.local'/'share'/'youtube-terminal'/'floating-player'

def pin_command(message):
    try:
        with socket.create_connection(('127.0.0.1', 49381), timeout=.5) as conn:
            conn.sendall((message+'\n').encode())
            return conn.recv(64).startswith(b'ok')
    except OSError:
        return False

def is_pinned():
    return pin_command('ping')

def start_pin():
    st=load_state()
    video=st.get('video')
    if not video: raise RuntimeError('play a video first: yt play <url|index>')
    if not PIN_BIN.is_file(): raise RuntimeError('floating player missing; run ./install.sh again (requires Xcode Command Line Tools)')
    if is_pinned():
        print('already pinned')
        return
    w,h=st.get('size',[300,250])
    subprocess.Popen([str(PIN_BIN),video,str(w),str(h),st.get('theme','light')],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    for _ in range(40):
        time.sleep(.15)
        if is_pinned(): break
    else: raise RuntimeError('floating player failed to start')
    try: with_window('set minimized of w to true')
    except RuntimeError: pass
    print('pinned: native floating player (all apps and desktops)')

def stop_pin():
    if not is_pinned():
        print('player is not pinned')
        return
    pin_command('quit')
    try: with_window('set minimized of w to false\n set index of w to 1')
    except RuntimeError: pass
    print('unpinned: Chrome player restored')

def main():
    a=sys.argv[1:]; cmd=a.pop(0) if a else None
    if cmd=='search':
        if not a: raise RuntimeError('missing query (usage: yt search <query>)')
        if not shutil.which('yt-dlp'): raise RuntimeError('yt-dlp not found (install with: brew install yt-dlp)')
        p=call(['yt-dlp','--flat-playlist','--dump-single-json','ytsearch8:'+' '.join(a)])
        if p.returncode:raise RuntimeError('search failed: '+p.stderr[-500:])
        items=[{'id':e['id'],'title':e.get('title','Untitled')} for e in json.loads(p.stdout).get('entries',[]) if e and e.get('id')]
        RESULTS.write_text(json.dumps(items,ensure_ascii=False))
        for i,x in enumerate(items,1):print(f'\033[32m{i:>2} ❯\033[0m {x["title"]}')
    elif cmd=='play':
        if not a:raise RuntimeError('missing video (usage: yt play <index|url>)')
        s=' '.join(a);idx=None
        if s.isdigit() and len(s)<4:
            try:
                idx=int(s)-1;video=json.loads(RESULTS.read_text())[idx]['id']
            except (ValueError,IndexError,OSError,KeyError):raise RuntimeError('no matching result (run `yt search` first)')
        else:video=video_id(s)
        if not video:raise RuntimeError('invalid video index or URL')
        open_video(video,idx)
    elif cmd in ('next','prev'):
        st=load_state();idx=st.get('index')
        if idx is None:raise RuntimeError('no playlist position; play a search result first')
        idx+=1 if cmd=='next' else -1
        try:video=json.loads(RESULTS.read_text())[idx]['id']
        except (ValueError,IndexError,OSError,KeyError):raise RuntimeError('no more search results')
        open_video(video,idx)
    elif cmd in ('dark', 'light'):
        st=load_state();st['theme']=cmd;save_state(st)
        if is_pinned():
            if not pin_command('theme '+cmd): raise RuntimeError('could not update floating player theme')
            print('floating player theme: '+cmd)
        else:
            print('saved '+cmd+' theme; run yt pin to apply it to the floating player')
    elif cmd=='pin': start_pin()
    elif cmd=='unpin': stop_pin()
    elif cmd=='size':
        if len(a)!=2 or not all(x.isdigit() for x in a):raise RuntimeError('invalid size (usage: yt size <width> <height>)')
        w,h=map(int,a)
        if not 180<=w<=1600 or not 160<=h<=1200:raise RuntimeError('size out of range (width: 180-1600, height: 160-1200)')
        # Keep top-left position, adjust bounds.
        st=load_state();st['size']=[w,h];save_state(st)
        if is_pinned(): pin_command(f'size {w} {h}')
        try:with_window('set b to bounds of w\n set bounds of w to {item 1 of b, item 2 of b, (item 1 of b) + %d, (item 2 of b) + %d}'%(w,h))
        except RuntimeError:pass
    elif cmd=='hide' and is_pinned(): pin_command('hide')
    elif cmd=='show' and is_pinned(): pin_command('show')
    elif cmd=='hide':with_window('set minimized of w to true')
    elif cmd=='show':with_window('set minimized of w to false\n set index of w to 1\n activate')
    elif cmd=='close':
        if is_pinned(): pin_command('quit')
        with_window('close w')
        st=load_state();st.pop('window_id',None);st.pop('video',None);save_state(st)
    elif cmd in ('pause','resume'):
        if is_pinned(): pin_command(cmd)
        else: player_key('k')
    elif cmd=='stop':
        if is_pinned(): pin_command('pause')
        else: player_key('k')
    elif cmd=='help':
        print("yt <command> [args]\n\nsearch <query> | play <index|url> | next | prev\npause | resume | stop | size <width> <height>\npin | unpin | dark | light | hide | show | close | help")
    elif cmd is None:
        return
    else:
        raise RuntimeError(f'unknown command: {cmd}')

if __name__=='__main__':
    try:main()
    except (RuntimeError,KeyboardInterrupt) as e:sys.exit('error: '+str(e))
